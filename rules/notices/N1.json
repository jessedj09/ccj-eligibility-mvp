  "layers": {
    "신혼부부": {
      "conditions": [
        {
          "id": "N1-M-marital",
          "field": "marital_status",
          "required": true,
          "source": {
            "page": 5,
            "clause": "①-㉮/㉯",
            "quote": [
              "(신혼부부) 혼인중인 자",
              "(예비신혼부부) 혼인을 계획 중이며 입주 전까지 혼인사실을 증명할 수 있을 것"
            ]
          },
          "note": "혼인 중이거나 예비신혼부부인지",
          "check": {
            "in": [
              {
                "var": "marital_status"
              },
              [
                "혼인중",
                "예비신혼"
              ]
            ]
          }
        },
        {
          "id": "N1-M-home",
          "field": "home_ownership",
          "required": true,
          "source": {
            "page": 4,
            "clause": "(무주택세대구성원)",
            "quote": [
              "무주택세대구성원(예비신혼부부의 경우 혼인으로 구성될 세대의 세대구성원"
            ]
          },
          "note": "무주택 세대구성원인지",
          "check": {
            "eq": [
              {
                "var": "home_ownership"
              },
              "무주택"
            ]
          }
        },
        {
          "id": "N1-M-income",
          "field": "household_income",
          "required": true,
          "source": {
            "page": 5,
            "clause": "③(자녀가산표 p.5, 상세 소득기준표 p.6)",
            "quote": [
              "월평균소득이 전년도 도시근로자 가구원수별 가구당 월평균소득의 100퍼센트 이하(맞벌이 부부 120퍼센트 이하)일 것"
            ],
            "derivation": "예비신혼부부의 가구원수는 신청자 본인과 예비배우자, 공고일 기준 동일 세대에 등재된 직계존속·비속을 포함해 산정한다(정부 지침, 사용자 제공 — 공고문 PDF에는 이 문장이 없다. 공고문은 '혼인으로 구성될 세대'만 명시: N1 p.5 ③④ / N3 p.9 ③④). 따라서 신혼부부·예비신혼부부 모두 가구원수 1은 모순이다."
          },
          "note": "가구 소득이 자녀수·맞벌이 여부에 따른 소득기준(가산표) 이내인지",
          "check": {
            "lte": [
              {
                "var": "monthly_income"
              },
              {
                "lookup": [
                  "income_standard",
                  {
                    "var": "household_size"
                  },
                  {
                    "term": "ratio"
                  }
                ]
              }
            ]
          },
          "table": "spouse_terms_married"
        },
        {
          "id": "N1-M-assets",
          "field": "total_assets",
          "required": true,
          "source": {
            "page": 5,
            "quote": [
              "총 자산가액 합산기준 34,500만원 이하"
            ],
            "clause": "④(자녀가산표)"
          },
          "note": "총자산이 자녀수에 따른 자산기준(가산표) 이내인지",
          "check": {
            "lte": [
              {
                "var": "total_assets"
              },
              {
                "term": "asset_limit"
              }
            ]
          },
          "table": "spouse_terms_married"
        },
        {
          "id": "N1-M-car",
          "field": "car_value",
          "required": true,
          "source": {
            "page": 5,
            "quote": [
              "총 자산 중 자동차가액이 4,542만원 이하일 것"
            ],
            "clause": "④(자녀가산표)"
          },
          "note": "자동차가액이 자녀수에 따른 자동차기준(가산표) 이내인지",
          "check": {
            "lte": [
              {
                "var": "car_value",
                "unknown_values": [
                  "확인불가"
                ]
              },
              {
                "term": "car_limit"
              }
            ]
          },
          "table": "spouse_terms_married"
        },
        {
          "id": "N1-M-sub",
          "field": "has_subscription_account",
          "required": true,
          "source": {
            "page": 5,
            "clause": "⑤",
            "quote": [
              "본인 또는 배우자(예비신혼부부의 경우는 혼인 예정인 배우자) 중 1인이 입주 전까지 주택청약종합저축(청약저축 포함) 가입사실을 증명할 수 있을 것"
            ]
          },
          "note": "[입주 전까지 이행] 본인 또는 배우자 명의 청약통장 가입사실을 증명할 수 있는지(신청 시점 미가입은 현재 자격에 영향 없음)",
          "check": true,
          "timing": "BEFORE_MOVE_IN"
        },
        {
          "id": "N1-M-duration",
          "field": "marriage_duration_or_child",
          "required": true,
          "source": {
            "page": 5,
            "clause": "②",
            "quote": [
              "혼인기간이 7년 이내일 것 또는 6세 이하 자녀(태아포함)를 둔 자",
              "2019. 7. 29. 이후 혼인신고",
              "2019. 7. 30. 이후 출생"
            ]
          },
          "note": "혼인기간 7년 이내이거나 6세 이하 자녀(태아포함)를 두었는지 (예비신혼부부는 이 요건이 적용되지 않음)",
          "check": {
            "any": [
              {
                "eq": [
                  {
                    "var": "marital_status"
                  },
                  "예비신혼"
                ]
              },
              {
                "gte": [
                  {
                    "var": "marriage_date"
                  },
                  {
                    "date": "2019-07-29"
                  }
                ]
              },
              {
                "if": [
                  {
                    "is": [
                      {
                        "var": "has_children"
                      },
                      false
                    ]
                  },
                  false,
                  {
                    "gte": [
                      {
                        "var": "youngest_child_birth_date"
                      },
                      {
                        "date": "2019-07-30"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
