  "tables": {
    "spouse_terms_married": {
      "label": "신혼부부·예비신혼부부 출생자녀 가산 소득·자산·자동차 기준: 가구원수×출생자녀수×맞벌이",
      "source": {
        "page": 5,
        "quote": [
          "345,000,000원",
          "379,000,000원",
          "413,000,000원",
          "45,420,000원",
          "49,960,000원",
          "54,510,000원"
        ]
      },
      "columns": [
        "size",
        "child",
        "dual"
      ],
      "inputs": {
        "size": {
          "var": "household_size"
        },
        "child": {
          "fn": "child_bonus_count"
        },
        "dual": {
          "var": "dual_income"
        }
      },
      "outputs": [
        "ratio",
        "asset_limit",
        "car_limit"
      ],
      "rows": [
        {
          "when": {
            "size": 1,
            "child": "any",
            "dual": "any"
          },
          "result": "NO_ROW",
          "no_row": {
            "code": "INPUT_INCONSISTENT",
            "detail": "신혼부부·예비신혼부부의 가구원수는 부부 2인 이상이어야 합니다(예비신혼부부는 신청자+예비배우자+공고일 기준 동일 세대에 등재된 직계존속·비속). 가구원수를 확인해 주세요."
          }
        },
        {
          "when": {
            "size": 2,
            "child": 0,
            "dual": true
          },
          "out": [
            130,
            345000000,
            45420000
          ]
        },
        {
          "when": {
            "size": 2,
            "child": 0,
            "dual": false
          },
          "out": [
            110,
            345000000,
            45420000
          ]
        },
        {
          "when": {
            "size": 2,
            "child": "1+",
            "dual": "any"
          },
          "result": "NO_ROW",
          "no_row": {
            "code": "INPUT_INCONSISTENT",
            "detail": "가구원수가 2인(부부만)인데 출생자녀 가산 대상 자녀가 있습니다. 가구원수 또는 자녀 입력을 확인해 주세요(태아만 있는 경우 가구원수에 포함되는지 확인 필요)."
          }
        },
        {
          "when": {
            "size": 3,
            "child": 0,
            "dual": true
          },
          "out": [
            120,
            345000000,
            45420000
          ]
        },
        {
          "when": {
            "size": 3,
            "child": 0,
            "dual": false
          },
          "out": [
            100,
            345000000,
            45420000
          ]
        },
        {
          "when": {
            "size": 3,
            "child": 1,
            "dual": true
          },
          "out": [
            130,
            379000000,
            49960000
          ]
        },
        {
          "when": {
            "size": 3,
            "child": 1,
            "dual": false
          },
          "out": [
            110,
