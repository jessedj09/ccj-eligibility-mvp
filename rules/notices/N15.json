          }
        },
        {
          "when": {
            "size": 2,
            "dual": false
          },
          "out": [
            140
          ]
        },
        {
          "when": {
            "size": 2,
            "dual": true
          },
          "out": [
            210
          ]
        },
        {
          "when": {
            "size": "3-6",
            "dual": false
          },
          "out": [
            130
          ]
        },
        {
          "when": {
            "size": "3-6",
            "dual": true
          },
          "out": [
            200
          ]
        },
        {
          "when": {
            "size": "7+",
            "dual": "any"
          },
          "result": "NO_ROW",
          "no_row": {
            "code": "AMBIGUOUS_SOURCE",
