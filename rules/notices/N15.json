            "quote": [
              "무주택세대구성원으로서 신혼·신생아 매입임대주택"
            ],
            "page": 3
          },
          "note": "무주택세대구성원인지(세대 전원 무주택)",
          "check": {
            "eq": [
              {
                "var": "home_ownership"
              },
              "무주택"
            ]
